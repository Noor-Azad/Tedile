# PoltuDa.in Configuration
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=development
FLASK_APP=app.py
DEBUG=True
SECRET_KEY=your_secret_key_here_change_in_production

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/poltuda_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=poltuda_db
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRES=3600

# Email Configuration (SendGrid or similar)
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=your_sendgrid_api_key

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# AWS S3 (for image storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_bucket_name
AWS_S3_REGION=us-east-1

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0

# Application Settings
APP_NAME=PoltuDa.in
APP_DESCRIPTION=Local Service Provider Marketplace
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Location Settings
DEFAULT_SEARCH_RADIUS_KM=10
MAX_SEARCH_RADIUS_KM=50

# Twilio (optional - for SMS/WhatsApp)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=your_phone_number
