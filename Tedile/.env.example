# Environment variables for local development.
# Copy this file to .env and fill in real values; never commit the real .env file.

FLASK_DEBUG=true
APP_ENV=development

# Required by the `flask` CLI (e.g. `flask db upgrade`) to locate create_app().
FLASK_APP=app.py

# Leave unset locally to auto-generate a dev-only secret key.
SECRET_KEY=

# Fernet key encrypting PII at rest (phone/whatsapp). Leave unset locally to
# auto-generate a dev-only key. Generate a real one for production with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Leave unset locally to use SQLite (sqlite:///tedile.db).
DATABASE_URL=

AWS_REGION=ap-south-1
S3_BUCKET_NAME=tedile-app
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
